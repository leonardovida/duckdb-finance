fin_sma: named argument 'period := ...' is not supported

query R
SELECT fin_sma(x, 2 ORDER BY i) FROM (VALUES (1, 1.0), (2, 3.0), (3, 5.0)) AS t(i, x)
----
4.0

query RR
SELECT round((fin_macd(x, 2, 3, 2 ORDER BY i)).macd, 9), round(fin_rsi(x, 2 ORDER BY i), 9) FROM (VALUES (1, 1.0), (2, 2.0), (3, 4.0), (4, 3.0), (5, 5.0)) AS t(i, x)
----
0.5	84.615384615

