require finance

statement ok
LOAD finance

query I
SELECT starts_with(fin_version(), 'finance')
----
true

statement error
SELECT fin_quantile_spread(factor, forward_return, buckets)
FROM (
    VALUES
        (1.0, 1.0, 2),
        (2.0, 2.0, 5)
) AS t(factor, forward_return, buckets)

statement error
SELECT fin_sortino(r, mar, annualization)
FROM (
    VALUES
        (0.10, 0.0, 252.0),
        (-0.05, 0.0, 365.0)
) AS t(r, mar, annualization)

statement error
SELECT fin_outlier_count(x, method, threshold)
FROM (
    VALUES
        (0.0, 'zscore', 1.0),
        (10.0, 'zscore', 10.0)
) AS t(x, method, threshold)

statement error
SELECT fin_weighted_var(x, w, ddof)
FROM (VALUES (999.0, 0.0, 0.0), (1.0, 1.0, 1.0)) AS t(x, w, ddof)
----
Weighted variance ddof must be constant within a group

statement error
SELECT fin_weighted_var(x, w, ddof)
FROM (VALUES (1.0, 1.0, 0.0), (999.0, 0.0, 1.0)) AS t(x, w, ddof)
----
Weighted variance ddof must be constant within a group

statement error
SELECT fin_outlier_count('NaN'::DOUBLE, 0.0)
----
Outlier threshold must be positive and finite

statement error
SELECT fin_outlier_count(x, threshold ORDER BY seq)
FROM (VALUES (1, 0.0, 1.0), (2, 'NaN'::DOUBLE, 2.0)) AS t(seq, x, threshold)
----
Outlier threshold must be constant within a group

statement error
SELECT fin_rate(x, t, 'fortnight') FROM (VALUES (1.0, TIMESTAMP '2026-01-01')) AS v(x, t)
----
fin_rate: unknown unit 'fortnight'

statement error
