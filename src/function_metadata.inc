	{"fin_spread_bps", "Technical Indicators And Microstructure", "Compute spread bps for SQL finance workflows.", "SELECT fin_spread_bps(bid, ask);"},
	{"fin_stddev", "Technical Indicators And Microstructure", "Rolling standard deviation of the last `period` values, population by default (TA-Lib `STDDEV` with nbdev 1).", "SELECT fin_stddev(close, 20, 0 ORDER BY ts);"},
	{"fin_stoch", "Technical Indicators And Microstructure", "Slow stochastic oscillator: `fastK = 100 * (close - LL) / (HH - LL)` over the last `k` rows, `k = SMA(fastK, smooth)` and `d = SMA(k, d)` (TA-Lib `STOCH` with SMA smoothing; fastk_period = `k`, slowk_period = `smooth`, slowd_period = `d`).", "SELECT fin_stoch(high, low, close, 14, 3, 3 ORDER BY ts);"},
	{"fin_stochrsi", "Technical Indicators And Microstructure", "Stochastic RSI: `k = 100 * (RSI - min RSI) / (max RSI - min RSI)` over the last `k` RSI(`period`) values and `d = SMA(k, d)` (TA-Lib `STOCHRSI` with fastk_period = `k`, fastd_period = `d`).", "SELECT fin_stochrsi(close, 14, 3, 3 ORDER BY ts);"},
	{"fin_t3", "Technical Indicators And Microstructure", "Tillson T3: six chained SMA-seeded EMAs combined as `c1 e6 + c2 e5 + c3 e4 + c4 e3` with volume-factor coefficients (TA-Lib `T3`).", "SELECT fin_t3(close, 5, 0.7 ORDER BY ts);"},
	{"fin_tema", "Technical Indicators And Microstructure", "Triple exponential moving average `3 * EMA1 - 3 * EMA2 + EMA3` of chained, SMA-seeded EMA stages (TA-Lib `TEMA`).", "SELECT fin_tema(close, 20 ORDER BY ts);"},
	{"fin_trade_sign", "Technical Indicators And Microstructure", "Compute trade sign for SQL finance workflows.", "SELECT fin_trade_sign(102.0::DOUBLE, 100.0::DOUBLE, 101.0::DOUBLE);"},
