	{"fin_vpin", "Technical Indicators And Microstructure", "Compute vpin for SQL finance workflows.", "SELECT fin_vpin(signed_volume, volume, buckets := 50);"},
	{"fin_vwap", "Technical Indicators And Microstructure", "Compute vwap for SQL finance workflows.", "SELECT fin_vwap(price, volume);"},
	{"fin_weighted_close", "Technical Indicators And Microstructure", "Compute weighted close for SQL finance workflows.", "SELECT fin_weighted_close(high, low, close);"},
	{"fin_willr", "Technical Indicators And Microstructure", "Williams %R `-100 * (HH - close) / (HH - LL)` over the last `period` rows (TA-Lib `WILLR`).", "SELECT fin_willr(high, low, close, 14 ORDER BY ts);"},
	{"fin_wma", "Technical Indicators And Microstructure", "Linearly weighted moving average of the last `period` values, weights `1..period` with the newest row heaviest (TA-Lib `WMA`).", "SELECT fin_wma(close, 20 ORDER BY ts);"},
	{"fin_black_litterman_returns", "Portfolio, Matrix, And Factor Analytics", "Black-Litterman posterior expected returns.", "SELECT fin_black_litterman_returns(market_weights, cov_matrix, views_p, views_q, tau := 0.05, omega := NULL, risk_aversion := 2.5);"},
