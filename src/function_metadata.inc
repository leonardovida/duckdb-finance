	{"fin_plus_dm", "Technical Indicators And Microstructure", "Compute plus dm for SQL finance workflows.", "SELECT fin_plus_dm(high, low, period := 14);"},
	{"fin_ppo", "Technical Indicators And Microstructure", "Percentage price oscillator `100 * (MA(fast) - MA(slow)) / MA(slow)` (TA-Lib `PPO`).", "SELECT fin_ppo(close, 12, 26, 'sma' ORDER BY ts);"},
	{"fin_queue_imbalance", "Technical Indicators And Microstructure", "Compute queue imbalance for SQL finance workflows.", "SELECT fin_queue_imbalance(bid_size, ask_size);"},
	{"fin_roc", "Technical Indicators And Microstructure", "Rate of change in percent `100 * (x_t / x_(t-period) - 1)` (TA-Lib `ROC`).", "SELECT fin_roc(close, 10 ORDER BY ts);"},
	{"fin_rocp", "Technical Indicators And Microstructure", "Rate of change as a fraction `(x_t - x_(t-period)) / x_(t-period)` (TA-Lib `ROCP`).", "SELECT fin_rocp(close, 10 ORDER BY ts);"},
	{"fin_rocr", "Technical Indicators And Microstructure", "Rate of change ratio `x_t / x_(t-period)` (TA-Lib `ROCR`).", "SELECT fin_rocr(close, 10 ORDER BY ts);"},
	{"fin_rocr100", "Technical Indicators And Microstructure", "Rate of change ratio in percent `100 * x_t / x_(t-period)` (TA-Lib `ROCR100`).", "SELECT fin_rocr100(close, 10 ORDER BY ts);"},
	{"fin_roll_spread", "Technical Indicators And Microstructure", "Compute roll spread for SQL finance workflows.", "SELECT fin_roll_spread(price);"},
	{"fin_rsi", "Technical Indicators And Microstructure", "Wilder relative strength index `100 * avg_gain / (avg_gain + avg_loss)`; the averages are seeded with the mean of the first `period` changes, then updated as `(avg * (period - 1) + change) / period` (TA-Lib `RSI`).", "SELECT fin_rsi(close, 14 ORDER BY ts);"},
	{"fin_sar", "Technical Indicators And Microstructure", "Wilder parabolic SAR with TA-Lib's algorithm: the first two bars' directional movement sets the initial trend; the acceleration factor starts at `acceleration`, grows by `acceleration` at each new extreme and is capped at `maximum` (TA-Lib `SAR`).", "SELECT fin_sar(high, low, 0.02, 0.2 ORDER BY ts);"},
	{"fin_sarext", "Technical Indicators And Microstructure", "Extended parabolic SAR (TA-Lib `SAREXT`) with positional `start_value` (0 = automatic direction, > 0 start long at that SAR, < 0 start short at its absolute value), `offset_on_reverse`, `af_init_long`, `af_long`, `af_max_long`, `af_init_short`, `af_short`, `af_max_short`.", "SELECT fin_sarext(high, low, 0, 0, 0.02, 0.02, 0.2, 0.02, 0.02, 0.2 ORDER BY ts);"},
	{"fin_sma", "Technical Indicators And Microstructure", "Simple moving average: mean of the last `period` values (TA-Lib `SMA`).", "SELECT fin_sma(close, 20 ORDER BY ts);"},
