	{"fin_adxr", "Technical Indicators And Microstructure", "Compute adxr for SQL finance workflows.", "SELECT fin_adxr(high, low, close, period := 14);"},
	{"fin_amihud_illiquidity", "Technical Indicators And Microstructure", "Compute amihud illiquidity for SQL finance workflows.", "SELECT fin_amihud_illiquidity(abs_return, dollar_volume);"},
	{"fin_apo", "Technical Indicators And Microstructure", "Absolute price oscillator `MA(fast) - MA(slow)` (TA-Lib `APO`).", "SELECT fin_apo(close, 12, 26, 'sma' ORDER BY ts);"},
	{"fin_aroon", "Technical Indicators And Microstructure", "Aroon over the last `period + 1` rows: `aroon_up = 100 * (period - rows since the highest high) / period`, `aroon_down` likewise for the lowest low; ties pick the most recent extreme (TA-Lib `AROON`).", "SELECT fin_aroon(high, low, 14 ORDER BY ts);"},
	{"fin_aroonosc", "Technical Indicators And Microstructure", "Aroon oscillator `aroon_up - aroon_down` (TA-Lib `AROONOSC`).", "SELECT fin_aroonosc(high, low, 14 ORDER BY ts);"},
	{"fin_atr", "Technical Indicators And Microstructure", "Compute atr for SQL finance workflows.", "SELECT fin_atr(high, low, close, period := 14);"},
	{"fin_avg_price", "Technical Indicators And Microstructure", "Compute avg price for SQL finance workflows.", "SELECT fin_avg_price(open, high, low, close);"},
	{"fin_bbands", "Technical Indicators And Microstructure", "Bollinger Bands: `middle = SMA(period)`, `upper`/`lower = middle +/- k * stddev` of the last `period` values (TA-Lib `BBANDS` with SMA and nbdevup = nbdevdn = `k`).", "SELECT fin_bbands(close, 20, 2.0, 0 ORDER BY ts);"},
	{"fin_bop", "Technical Indicators And Microstructure", "Compute bop for SQL finance workflows.", "SELECT fin_bop(open, high, low, close);"},
	{"fin_cci", "Technical Indicators And Microstructure", "Commodity channel index `(TP - SMA(TP)) / (constant * mean absolute deviation of TP)` over the last `period` rows, `TP = (high + low + close) / 3` (TA-Lib `CCI`).", "SELECT fin_cci(high, low, close, 20, 0.015 ORDER BY ts);"},
	{"fin_cmo", "Technical Indicators And Microstructure", "Chande momentum oscillator `100 * (avg_gain - avg_loss) / (avg_gain + avg_loss)` with Wilder averages seeded like RSI (TA-Lib `CMO`).", "SELECT fin_cmo(close, 14 ORDER BY ts);"},
	{"fin_dema", "Technical Indicators And Microstructure", "Double exponential moving average `2 * EMA - EMA(EMA)`; each EMA stage is seeded with the SMA of its first `period` inputs (TA-Lib `DEMA`).", "SELECT fin_dema(close, 20 ORDER BY ts);"},
	{"fin_donchian", "Technical Indicators And Microstructure", "Donchian channel over the last `period` rows: `upper` = highest high, `lower` = lowest low, `middle = (upper + lower) / 2`.", "SELECT fin_donchian(high, low, 20 ORDER BY ts);"},
	{"fin_dx", "Technical Indicators And Microstructure", "Compute dx for SQL finance workflows.", "SELECT fin_dx(high, low, close, period := 14);"},
	{"fin_hma", "Technical Indicators And Microstructure", "Hull moving average `WMA(2 * WMA(x, floor(period / 2)) - WMA(x, period), floor(sqrt(period)))` (Alan Hull; not part of TA-Lib).", "SELECT fin_hma(close, 20 ORDER BY ts);"},
	{"fin_kama", "Technical Indicators And Microstructure", "Kaufman adaptive moving average: efficiency ratio `abs(x_t - x_(t-period)) / sum(abs(x_i - x_(i-1)))` maps to the smoothing constant `(ER * (2/(fast+1) - 2/(slow+1)) + 2/(slow+1))^2`, seeded with the price at row `period - 1` (TA-Lib `KAMA`, which fixes fast 2 and slow 30).", "SELECT fin_kama(close, 10, 2, 30 ORDER BY ts);"},
	{"fin_keltner", "Technical Indicators And Microstructure", "Keltner channel: `middle = EMA(close, period)` (TA-Lib seeding) and bands `middle +/- multiplier * ATR(atr_period)` with TA-Lib Wilder ATR (StockCharts definition; not part of TA-Lib).", "SELECT fin_keltner(high, low, close, 20, 10, 2.0 ORDER BY ts);"},
	{"fin_kyle_lambda", "Technical Indicators And Microstructure", "Compute kyle lambda for SQL finance workflows.", "SELECT fin_kyle_lambda(signed_volume, price_change);"},
	{"fin_linearreg", "Technical Indicators And Microstructure", "Least-squares line over the last `period` values (x = 0 for the oldest row) evaluated at the newest row (TA-Lib `LINEARREG`).", "SELECT fin_linearreg(close, 14 ORDER BY ts);"},
	{"fin_linearreg_intercept", "Technical Indicators And Microstructure", "Intercept of the least-squares line over the last `period` values, i.e. its value at the oldest row of the lookback (TA-Lib `LINEARREG_INTERCEPT`).", "SELECT fin_linearreg_intercept(close, 14 ORDER BY ts);"},
	{"fin_linearreg_slope", "Technical Indicators And Microstructure", "Slope per row of the least-squares line over the last `period` values (TA-Lib `LINEARREG_SLOPE`).", "SELECT fin_linearreg_slope(close, 14 ORDER BY ts);"},
	{"fin_macd", "Technical Indicators And Microstructure", "MACD line `EMA(fast) - EMA(slow)`, `signal = EMA(signal)` of the line and `hist = macd - signal` (TA-Lib `MACD`: both EMAs start at row `slow - 1`, the fast one seeded with the SMA of the `fast` rows ending there).", "SELECT fin_macd(close, 12, 26, 9 ORDER BY ts);"},
	{"fin_median_price", "Technical Indicators And Microstructure", "Compute median price for SQL finance workflows.", "SELECT fin_median_price(high, low);"},
