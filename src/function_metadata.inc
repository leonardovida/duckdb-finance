	{"fin_option_market_spec", "Options And Volatility Models", "Build a European BSM option spec from expiry and valuation dates.", "SELECT fin_option_market_spec(kind, spot, strike, expiry, valuation_date, rate, vol, dividend_yield := 0.0, calendar := 'weekday', day_count := 'ACT/365F');"},
