    {"finance_t_struct_internal", "(stat, df) AS CASE WHEN stat IS NULL THEN NULL ELSE struct_pack(stat := stat::DOUBLE, pvalue := CASE WHEN isfinite(stat::DOUBLE) AND df::DOUBLE > 0 THEN 2.0 * fin_student_t_cdf(-abs(stat::DOUBLE), df::DOUBLE) END, df := df::DOUBLE) END"},
    {"finance_ttest2_internal", "(diff, vx, vy, nx, ny, equal_var) AS finance_t_struct_internal(CASE WHEN nx < 2 OR ny < 2 THEN NULL WHEN equal_var THEN diff / nullif(sqrt(((nx - 1) * vx + (ny - 1) * vy) / (nx + ny - 2) * (1.0 / nx + 1.0 / ny)), 0) ELSE diff / nullif(sqrt(vx / nx + vy / ny), 0) END, CASE WHEN nx < 2 OR ny < 2 THEN NULL WHEN equal_var THEN nx + ny - 2 ELSE pow(vx / nx + vy / ny, 2) / nullif(pow(vx / nx, 2) / (nx - 1) + pow(vy / ny, 2) / (ny - 1), 0) END)"},
    {"finance_z_struct_internal", "(stat) AS CASE WHEN stat IS NULL THEN NULL ELSE struct_pack(stat := stat::DOUBLE, pvalue := CASE WHEN isfinite(stat::DOUBLE) THEN 2.0 * fin_norm_cdf(-abs(stat::DOUBLE)) END) END"},
    {"finance_money_round_internal", "(v, scale, mode) AS CASE WHEN scale IS NULL OR NOT (scale::DOUBLE BETWEEN 0 AND 9) OR scale::DOUBLE <> floor(scale::DOUBLE) THEN error('fin_money_round: scale must be an integer between 0 and 9') WHEN mode IS NULL OR lower(mode) NOT IN ('nearest', 'half_even', 'floor', 'ceil', 'truncate') THEN error('fin_money_round: unknown mode ''' || coalesce(mode, 'NULL') || '''; expected nearest, half_even, floor, ceil or truncate') ELSE round(CASE lower(mode) WHEN 'nearest' THEN round(v, scale) WHEN 'truncate' THEN trunc(v, scale) WHEN 'floor' THEN CASE WHEN v < trunc(v, scale) THEN trunc(v, scale) - pow(10, -scale)::DECIMAL(38,9) ELSE trunc(v, scale) END WHEN 'ceil' THEN CASE WHEN v > trunc(v, scale) THEN trunc(v, scale) + pow(10, -scale)::DECIMAL(38,9) ELSE trunc(v, scale) END ELSE CASE WHEN abs(v - trunc(v, scale)) = (0.5 * pow(10, -scale))::DECIMAL(38,9) AND right(replace(trunc(v, scale)::VARCHAR, '.', ''), 1)::INTEGER % 2 = 0 THEN trunc(v, scale) ELSE round(v, scale) END END, scale) END"},
    {"fin_ttest_1samp", "(x, mu) AS finance_t_struct_internal(CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) OR NOT isfinite(mu::DOUBLE) OR count(x) < 2 THEN NULL ELSE (avg(x::DOUBLE) - mu::DOUBLE) / nullif(stddev_samp(x::DOUBLE) FILTER (WHERE isfinite(x::DOUBLE)) / sqrt(count(x)::DOUBLE), 0) END, count(x) - 1)"},
    {"fin_ttest_2samp", "(x, y, equal_var := true) AS finance_ttest2_internal(CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) OR bool_or(NOT isfinite(y::DOUBLE)) THEN NULL ELSE avg(x::DOUBLE) - avg(y::DOUBLE) END, var_samp(x::DOUBLE) FILTER (WHERE isfinite(x::DOUBLE)), var_samp(y::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE)), count(x)::DOUBLE, count(y)::DOUBLE, CASE WHEN equal_var IS NULL THEN error('fin_ttest_2samp: equal_var must not be NULL') ELSE equal_var::BOOLEAN END)"},
    {"fin_welch_ttest", "(x, y) AS fin_ttest_2samp(x, y, false)"},
    {"fin_ztest_mean", "(x, mu, sigma := NULL) AS finance_z_struct_internal(CASE WHEN sigma IS NOT NULL AND NOT (sigma::DOUBLE > 0 AND isfinite(sigma::DOUBLE)) THEN error('fin_ztest_mean: sigma must be positive and finite') WHEN bool_or(NOT isfinite(x::DOUBLE)) OR NOT isfinite(mu::DOUBLE) OR count(x) < CASE WHEN sigma IS NULL THEN 2 ELSE 1 END THEN NULL ELSE (avg(x::DOUBLE) - mu::DOUBLE) / nullif(coalesce(sigma::DOUBLE, stddev_samp(x::DOUBLE) FILTER (WHERE isfinite(x::DOUBLE))) / sqrt(count(x)::DOUBLE), 0) END)"},
    {"fin_anova_oneway", "(value, \"group\") AS finance_anova_oneway_internal(value::DOUBLE, CASE WHEN \"group\" IS NULL THEN NULL ELSE (hash(\"group\") >> 11)::BIGINT END)"},
    {"fin_entropy", "(x) AS entropy(x)"},
    {"fin_rank_corr", "(x, y, method := 'spearman') AS finance_rank_corr_internal(x::DOUBLE, y::DOUBLE, method)"},
    {"fin_mutual_information", "(x, y, bins := 10) AS finance_mutual_information_internal(x::DOUBLE, y::DOUBLE, bins)"},
    {"fin_cramers_v", "(x, y, bias_corrected := true) AS finance_cramers_v_internal(CASE WHEN x IS NULL THEN NULL ELSE (hash(x) >> 11)::BIGINT END, CASE WHEN y IS NULL THEN NULL ELSE (hash(y) >> 11)::BIGINT END, bias_corrected)"},
    {"fin_theils_u", "(x, y) AS finance_theils_u_internal(CASE WHEN x IS NULL THEN NULL ELSE (hash(x) >> 11)::BIGINT END, CASE WHEN y IS NULL THEN NULL ELSE (hash(y) >> 11)::BIGINT END)"},
    {"fin_outlier_count", "(x, method := 'zscore', threshold := 3.0) AS count(*) FILTER (WHERE abs(x - avg(x)) / nullif(stddev_samp(x), 0) > threshold::DOUBLE)"},
    {"fin_missing_count", "(x) AS count(*) FILTER (WHERE x IS NULL)"},
    {"fin_data_quality_report", "(x) AS struct_pack(n := count(*), nulls := fin_missing_count(x), finite := count(*) FILTER (WHERE fin_is_finite(x)), min := min(x), max := max(x), outliers := fin_outlier_count(x))"},

    {"fin_money_sum", "(x) AS sum(x)"},
    {"fin_money_weighted_sum", "(amount, weight) AS fsum(amount::DOUBLE * weight::DOUBLE)"},
    {"fin_money_round", "(amount, scale := 2, mode := 'nearest') AS finance_money_round_internal(amount::DECIMAL(38,9), scale, mode)"},
    {"fin_cents_to_money", "(cents, scale := 2) AS CASE WHEN scale IS NULL OR NOT (scale::DOUBLE BETWEEN 0 AND 9) OR scale::DOUBLE <> floor(scale::DOUBLE) THEN error('fin_cents_to_money: scale must be an integer between 0 and 9') ELSE round(cents::DECIMAL(38,0) * round(pow(10, -scale)::DECIMAL(38,9), scale), scale) END"},
    {"fin_money_to_cents", "(amount, rounding := 'nearest') AS (fin_money_round(amount, 2, rounding) * 100)::BIGINT"},

    {"fin_option_spec", "(kind, spot, strike, ttm, rate, vol, dividend_yield := 0.0, exercise := 'european', model := 'bsm') AS struct_pack(kind := fin_parse_option_kind(kind), spot := spot::DOUBLE, strike := strike::DOUBLE, ttm := ttm::DOUBLE, rate := rate::DOUBLE, vol := vol::DOUBLE, dividend_yield := dividend_yield::DOUBLE, exercise := fin_parse_exercise_style(exercise), model := CASE WHEN model IS NULL THEN NULL WHEN lower(model) IN ('bsm', 'black76', 'bachelier', 'binomial') THEN lower(model) ELSE error('fin_option_spec: unknown model ''' || model || ''' (expected bsm, black76, bachelier or binomial)') END)"},
    {"fin_option_spec_dates", "(kind, spot, strike, valuation_date, expiry_date, rate, vol, dividend_yield := 0.0, day_count := 'ACT/365F', exercise := 'european', model := 'bsm') AS fin_option_spec(kind, spot, strike, fin_yearfrac(valuation_date, expiry_date, day_count), rate, vol, dividend_yield, exercise, model)"},
    {"fin_option_market_spec", "(kind, spot, strike, expiry, valuation_date, rate, vol, dividend_yield := 0.0, calendar := 'weekday', day_count := 'ACT/365F') AS fin_option_spec_dates(kind, spot, strike, valuation_date, expiry, rate, vol, dividend_yield, day_count, 'european', 'bsm')"},
    {"fin_rate_spec", "(rate, compounding := 'continuous', frequency := 1, day_count := 'ACT/365F') AS CASE WHEN try(fin_parse_compounding(compounding)) IS NULL THEN error('fin_rate_spec: unknown compounding ''' || coalesce(compounding, 'NULL') || '''') WHEN try(fin_parse_day_count(day_count)) IS NULL THEN error('fin_rate_spec: unknown day_count ''' || coalesce(day_count, 'NULL') || '''') WHEN frequency IS NULL OR NOT (frequency::DOUBLE >= 1) OR frequency::DOUBLE <> floor(frequency::DOUBLE) THEN error('fin_rate_spec: frequency must be a positive integer') ELSE struct_pack(rate := rate::DOUBLE, compounding := fin_parse_compounding(compounding), frequency := frequency::INTEGER, day_count := fin_parse_day_count(day_count)) END"},
    {"fin_curve_spec", "(maturities, \"values\", value_type := 'zero_rate', interpolation := 'linear', compounding := 'continuous', day_count := 'ACT/365F') AS CASE WHEN try(fin_parse_compounding(compounding)) IS NULL THEN error('fin_curve_spec: unknown compounding ''' || coalesce(compounding, 'NULL') || '''') WHEN try(fin_parse_day_count(day_count)) IS NULL THEN error('fin_curve_spec: unknown day_count ''' || coalesce(day_count, 'NULL') || '''') WHEN lower(value_type) NOT IN ('zero_rate', 'discount_factor') THEN error('fin_curve_spec: unknown value_type ''' || value_type || '''; expected zero_rate or discount_factor') WHEN lower(interpolation) <> 'linear' THEN error('fin_curve_spec: unknown interpolation ''' || interpolation || '''; only linear is supported') ELSE struct_pack(maturities := maturities::DOUBLE[], \"values\" := \"values\"::DOUBLE[], value_type := lower(value_type), interpolation := lower(interpolation), compounding := fin_parse_compounding(compounding), day_count := fin_parse_day_count(day_count)) END"},
    {"fin_cashflow_spec", "(amount, date, currency := NULL) AS struct_pack(amount := amount::DOUBLE, date := date::DATE, currency := upper(currency::VARCHAR))"},
    {"fin_portfolio_vector", "(weights, labels) AS CASE WHEN len(weights) <> len(labels) THEN error('fin_portfolio_vector: weights and labels must have the same length') ELSE struct_pack(labels := labels::VARCHAR[], weights := weights::DOUBLE[]) END"},
    {"fin_portfolio_spec", "(labels, weights, base_currency := NULL) AS CASE WHEN len(weights) <> len(labels) THEN error('fin_portfolio_spec: labels and weights must have the same length') ELSE struct_pack(labels := labels::VARCHAR[], weights := weights::DOUBLE[], base_currency := upper(base_currency::VARCHAR)) END"},
    {"fin_optimizer_spec", "(objective := 'max_sharpe', risk_free := 0.0, long_only := true, weight_min := 0.0, weight_max := 1.0, target_return := NULL, target_vol := NULL, risk_aversion := 1.0) AS CASE WHEN lower(objective) NOT IN ('max_sharpe', 'min_variance', 'risk_parity', 'target_return', 'target_vol', 'mean_variance') THEN error('fin_optimizer_spec: unknown objective ''' || objective || '''; expected max_sharpe, min_variance, risk_parity, target_return, target_vol or mean_variance') WHEN NOT isfinite(risk_free::DOUBLE) THEN error('fin_optimizer_spec: risk_free must be finite') WHEN NOT (weight_min::DOUBLE <= weight_max::DOUBLE) THEN error('fin_optimizer_spec: weight_min must not exceed weight_max') WHEN long_only AND weight_min::DOUBLE < 0 THEN error('fin_optimizer_spec: long_only requires weight_min >= 0') WHEN target_vol IS NOT NULL AND NOT (target_vol::DOUBLE > 0) THEN error('fin_optimizer_spec: target_vol must be positive') WHEN NOT (risk_aversion::DOUBLE > 0) THEN error('fin_optimizer_spec: risk_aversion must be positive') ELSE struct_pack(objective := lower(objective), risk_free := risk_free::DOUBLE, long_only := long_only::BOOLEAN, weight_min := weight_min::DOUBLE, weight_max := weight_max::DOUBLE, target_return := target_return::DOUBLE, target_vol := target_vol::DOUBLE, risk_aversion := risk_aversion::DOUBLE) END"},
    {"fin_var_spec", "(confidence := 0.95, method := 'historical', tail := 'left', loss_positive := true) AS CASE WHEN NOT (confidence::DOUBLE > 0 AND confidence::DOUBLE < 1) THEN error('fin_var_spec: confidence must be in (0, 1)') WHEN lower(method) NOT IN ('historical', 'parametric', 'cornish_fisher') THEN error('fin_var_spec: unknown method ''' || method || '''; expected historical, parametric or cornish_fisher') WHEN lower(tail) NOT IN ('left', 'right') THEN error('fin_var_spec: tail must be left or right') ELSE struct_pack(confidence := confidence::DOUBLE, method := lower(method), tail := lower(tail), loss_positive := loss_positive::BOOLEAN) END"},
    {"fin_risk_spec", "(annualization := 252, risk_free := 0.0, var_confidence := 0.95, tail := 'left', loss_positive := true) AS CASE WHEN NOT (annualization::DOUBLE > 0 AND isfinite(annualization::DOUBLE)) THEN error('fin_risk_spec: annualization must be positive and finite') WHEN NOT (risk_free::DOUBLE > -1 AND isfinite(risk_free::DOUBLE)) THEN error('fin_risk_spec: risk_free must be finite and greater than -1') WHEN NOT (var_confidence::DOUBLE > 0 AND var_confidence::DOUBLE < 1) THEN error('fin_risk_spec: var_confidence must be in (0, 1)') WHEN lower(tail) NOT IN ('left', 'right') THEN error('fin_risk_spec: tail must be left or right') ELSE struct_pack(annualization := annualization::DOUBLE, risk_free := risk_free::DOUBLE, var_confidence := var_confidence::DOUBLE, tail := lower(tail), loss_positive := loss_positive::BOOLEAN) END"},
    {"fin_ts_grid_spec", "(start_ts, end_ts, step, staleness := NULL, method := 'last') AS CASE WHEN NOT (step::INTERVAL > INTERVAL 0 SECOND) THEN error('fin_ts_grid_spec: step must be a positive interval') WHEN end_ts::TIMESTAMP < start_ts::TIMESTAMP THEN error('fin_ts_grid_spec: end_ts must not precede start_ts') WHEN staleness IS NOT NULL AND staleness::INTERVAL < INTERVAL 0 SECOND THEN error('fin_ts_grid_spec: staleness must not be negative') WHEN lower(method) <> 'last' THEN error('fin_ts_grid_spec: unknown method ''' || method || '''; only last is supported') ELSE struct_pack(start_ts := start_ts::TIMESTAMP, end_ts := end_ts::TIMESTAMP, step := step::INTERVAL, staleness := staleness::INTERVAL, method := lower(method)) END"},
    {"fin_bar_spec", "(kind, threshold, price_col := 'price', volume_col := 'volume') AS CASE WHEN lower(kind) NOT IN ('tick', 'volume', 'dollar', 'imbalance') THEN error('fin_bar_spec: unknown kind ''' || kind || '''; expected tick, volume, dollar or imbalance') WHEN NOT (threshold::DOUBLE > 0 AND isfinite(threshold::DOUBLE)) THEN error('fin_bar_spec: threshold must be positive and finite') ELSE struct_pack(kind := lower(kind), threshold := threshold::DOUBLE, price_col := price_col::VARCHAR, volume_col := volume_col::VARCHAR) END"},
    {"fin_calendar_spec", "(calendar := 'weekday', timezone := NULL, regular_open := NULL, regular_close := NULL) AS CASE WHEN lower(calendar) NOT IN ('weekday', 'weekdays', 'monfri', 'nyse', 'xnys') THEN error('fin_calendar_spec: unknown calendar ''' || calendar || '''; expected weekday or nyse') WHEN regular_open IS NOT NULL AND regular_close IS NOT NULL AND regular_close::TIME <= regular_open::TIME THEN error('fin_calendar_spec: regular_close must be after regular_open') ELSE struct_pack(calendar := CASE WHEN lower(calendar) IN ('nyse', 'xnys') THEN 'nyse' ELSE 'weekday' END, timezone := timezone::VARCHAR, regular_open := regular_open::TIME, regular_close := regular_close::TIME) END"},
    {"fin_typeof", "(x) AS typeof(x)"},
    {"fin_is_decimal_return", "(x) AS fin_validate_return(x)"},
    {"fin_validate_option_spec", "(spec) AS struct_pack(ok := coalesce(spec.kind IN ('call', 'put') AND isfinite(spec.spot) AND spec.spot > 0 AND isfinite(spec.strike) AND spec.strike > 0 AND isfinite(spec.ttm) AND spec.ttm >= 0 AND isfinite(spec.rate) AND isfinite(spec.vol) AND spec.vol >= 0 AND isfinite(coalesce(spec.dividend_yield, 0.0)), false), reason := CASE WHEN spec IS NULL THEN 'missing option spec' WHEN spec.kind IS NULL OR spec.kind NOT IN ('call', 'put') THEN 'kind must be call or put' WHEN NOT coalesce(isfinite(spec.spot) AND spec.spot > 0, false) THEN 'spot must be positive and finite' WHEN NOT coalesce(isfinite(spec.strike) AND spec.strike > 0, false) THEN 'strike must be positive and finite' WHEN NOT coalesce(isfinite(spec.ttm) AND spec.ttm >= 0, false) THEN 'ttm must be non-negative and finite' WHEN NOT coalesce(isfinite(spec.rate), false) THEN 'rate must be finite' WHEN NOT coalesce(isfinite(spec.vol) AND spec.vol >= 0, false) THEN 'vol must be non-negative and finite' WHEN NOT isfinite(coalesce(spec.dividend_yield, 0.0)) THEN 'dividend_yield must be finite' ELSE 'ok' END)"},
    {"fin_validate_rate_spec", "(spec) AS struct_pack(ok := coalesce(isfinite(spec.rate) AND spec.rate > -1 AND spec.rate <= 1 AND spec.compounding IN ('continuous', 'simple', 'periodic', 'semiannual', 'quarterly', 'monthly', 'daily') AND spec.day_count IN ('ACT/365F', 'ACT/360', 'ACT/ACT', 'ACT/ACT ICMA', '30/360', '30U/360', '30E/360') AND spec.frequency >= 1 AND spec.frequency = floor(spec.frequency), false), reason := CASE WHEN spec IS NULL THEN 'null rate spec' WHEN spec.rate IS NULL OR NOT isfinite(spec.rate) THEN 'rate must be finite' WHEN spec.rate <= -1 THEN 'rate must be greater than -1' WHEN spec.rate > 1 THEN 'rate above 1 (100%) looks like a percentage; pass decimal rates' WHEN spec.compounding IS NULL OR spec.compounding NOT IN ('continuous', 'simple', 'periodic', 'semiannual', 'quarterly', 'monthly', 'daily') THEN 'unknown compounding ''' || coalesce(spec.compounding, 'NULL') || '''' WHEN spec.day_count IS NULL OR spec.day_count NOT IN ('ACT/365F', 'ACT/360', 'ACT/ACT', 'ACT/ACT ICMA', '30/360', '30U/360', '30E/360') THEN 'unknown day_count ''' || coalesce(spec.day_count, 'NULL') || '''' WHEN spec.frequency IS NULL OR spec.frequency < 1 OR spec.frequency <> floor(spec.frequency) THEN 'frequency must be a positive integer' ELSE 'ok' END)"},
    {"fin_validate_curve_spec", "(spec) AS struct_pack(ok := fin_curve_zero_rate(spec.maturities, spec.values, 0.0) IS NOT NULL, reason := CASE WHEN spec.maturities IS NULL OR spec.values IS NULL THEN 'null curve input' WHEN len(spec.maturities) <> len(spec.values) THEN 'maturity/value length mismatch' WHEN len(spec.maturities) = 0 THEN 'curve cannot be empty' WHEN fin_curve_zero_rate(spec.maturities, spec.values, 0.0) IS NULL THEN 'maturities must be finite and strictly increasing; values must be finite and non-null' ELSE 'ok' END)"},

    {"fin_marginal_risk", "(weights, cov_matrix) AS fin_matrix_vecmul(cov_matrix, weights)"},
    {"fin_component_risk", "(weights, cov_matrix) AS fin_vector_scale(finance_vector_multiply_internal(weights, fin_matrix_vecmul(cov_matrix, weights)), 1.0 / nullif(fin_portfolio_vol(weights, cov_matrix), 0))"},
    {"fin_risk_contribution", "(weights, cov_matrix) AS fin_vector_normalize_sum(fin_component_risk(weights, cov_matrix))"},
    {"fin_turnover", "(old_weights, new_weights) AS fin_turnover(old_weights, new_weights)"},
    {"fin_equal_weights", "(n) AS fin_equal_weights(n)"},
    {"fin_inverse_vol_weights", "(vols) AS fin_inverse_vol_weights(vols)"},
    {"fin_portfolio_sharpe", "(weights, mu, cov_matrix, risk_free := 0.0) AS fin_portfolio_sharpe(weights, mu, cov_matrix, risk_free)"},
    {"fin_min_variance_weights", "(cov_matrix, long_only := true) AS finance_min_variance_weights_internal(cov_matrix, long_only)"},
    {"fin_risk_parity_weights", "(cov_matrix, budgets := NULL, tol := 1e-8, max_iter := 1000) AS finance_risk_parity_weights_internal(cov_matrix, budgets, tol, max_iter)"},
    {"fin_max_sharpe_weights", "(mu, cov_matrix, risk_free := 0.0, long_only := true) AS finance_max_sharpe_weights_internal(mu, cov_matrix, risk_free, long_only)"},
    {"fin_black_litterman_returns", "(market_weights, cov_matrix, views_p, views_q, tau := 0.05, omega := NULL, risk_aversion := 2.5) AS finance_black_litterman_internal(market_weights, cov_matrix, views_p, views_q, tau, omega, risk_aversion)"},
    {"fin_factor_alpha", "(r, factor_r, risk_free := 0.0, annualization := 252) AS fin_alpha(r, factor_r, risk_free, annualization)"},
    {"fin_factor_ic", "(factor, forward_return, method := 'spearman') AS finance_factor_ic_internal(factor::DOUBLE, forward_return::DOUBLE, method)"},
    {"fin_rank_ic", "(factor, forward_return) AS finance_factor_ic_internal(factor::DOUBLE, forward_return::DOUBLE, 'spearman')"},
    {"fin_quantile_spread", "(factor, forward_return, buckets := 5) AS avg(forward_return) FILTER (WHERE factor >= quantile_cont(factor, 1 - 1.0 / buckets)) - avg(forward_return) FILTER (WHERE factor <= quantile_cont(factor, 1.0 / buckets))"},
    {"fin_factor_turnover", "(ts, asset, factor, period := 1) AS finance_factor_turnover_internal(ts, CASE WHEN asset IS NULL THEN NULL ELSE (hash(asset) >> 11)::BIGINT END, factor::DOUBLE, period)"},
    {"fin_newey_west_tstat", "(y, x, ts, lags := 1) AS finance_newey_west_internal(y::DOUBLE, x::DOUBLE, ts, lags)"},
