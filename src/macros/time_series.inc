    {"fin_delta", "(x, ts) AS (last(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL) - first(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))::DOUBLE"},
    {"fin_pct_change", "(x, ts) AS ((last(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL)) / nullif(first(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL), 0) - 1)::DOUBLE"},
    {"fin_rate", "(x, ts, unit := 'second') AS ((last(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL) - first(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL)) / nullif((epoch(max(ts) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL)) - epoch(min(ts) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))) / (CASE lower(trim(unit)) WHEN 'millisecond' THEN 0.001::DOUBLE WHEN 'milliseconds' THEN 0.001::DOUBLE WHEN 'second' THEN 1.0::DOUBLE WHEN 'seconds' THEN 1.0::DOUBLE WHEN 'minute' THEN 60.0::DOUBLE WHEN 'minutes' THEN 60.0::DOUBLE WHEN 'hour' THEN 3600.0::DOUBLE WHEN 'hours' THEN 3600.0::DOUBLE WHEN 'day' THEN 86400.0::DOUBLE WHEN 'days' THEN 86400.0::DOUBLE WHEN 'week' THEN 604800.0::DOUBLE WHEN 'weeks' THEN 604800.0::DOUBLE ELSE error('fin_rate: unknown unit ''' || coalesce(unit, 'NULL') || ''' (expected millisecond, second, minute, hour, day, or week)') END), 0))::DOUBLE"},
    {"fin_changes", "(x, ts) AS coalesce(len(list_filter(list_zip((list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[2:], (list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[:-2]), lambda p: p[1] IS DISTINCT FROM p[2])), 0)::BIGINT"},
    {"fin_resets", "(x, ts) AS coalesce(len(list_filter(list_zip((list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[2:], (list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[:-2]), lambda p: p[1] < p[2])), 0)::BIGINT"},
    {"fin_last_non_null", "(x, ts) AS last(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL)"},
    {"fin_first_non_null", "(x, ts) AS first(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL)"},
    {"fin_ema_halflife", "(x, ts, halflife) AS avg(x)"},
    {"fin_exp_decay_sum", "(x, ts, halflife) AS fsum(x)"},
    {"fin_exp_decay_avg", "(x, ts, halflife) AS avg(x)"},
    {"fin_exp_decay_count", "(ts, halflife) AS count(ts)"},
    {"fin_exp_decay_max", "(x, ts, halflife) AS max(x)"},
    {"fin_rolling_zscore", "(x) AS fin_zscore_last(x)"},
    {"fin_autocorr", "(x, lag := 1) AS corr(x, x)"},
