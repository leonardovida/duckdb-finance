    {"fin_delta", "(x, ts) AS (finance_last_by_internal(x::DOUBLE, ts) - finance_first_by_internal(x::DOUBLE, ts))::DOUBLE"},
    {"fin_pct_change", "(x, ts) AS ((finance_last_by_internal(x::DOUBLE, ts)) / nullif(finance_first_by_internal(x::DOUBLE, ts), 0) - 1)::DOUBLE"},
    {"fin_rate", "(x, ts, unit := 'second') AS ((finance_last_by_internal(x::DOUBLE, ts) - finance_first_by_internal(x::DOUBLE, ts)) / nullif((epoch(max(ts) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL)) - epoch(min(ts) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))) / (CASE lower(trim(unit)) WHEN 'millisecond' THEN 0.001::DOUBLE WHEN 'milliseconds' THEN 0.001::DOUBLE WHEN 'second' THEN 1.0::DOUBLE WHEN 'seconds' THEN 1.0::DOUBLE WHEN 'minute' THEN 60.0::DOUBLE WHEN 'minutes' THEN 60.0::DOUBLE WHEN 'hour' THEN 3600.0::DOUBLE WHEN 'hours' THEN 3600.0::DOUBLE WHEN 'day' THEN 86400.0::DOUBLE WHEN 'days' THEN 86400.0::DOUBLE WHEN 'week' THEN 604800.0::DOUBLE WHEN 'weeks' THEN 604800.0::DOUBLE ELSE error('fin_rate: unknown unit ''' || coalesce(unit, 'NULL') || ''' (expected millisecond, second, minute, hour, day, or week)') END), 0))::DOUBLE"},
    {"fin_changes", "(x, ts) AS coalesce(len(list_filter(list_zip((list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[2:], (list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[:-2]), lambda p: p[1] IS DISTINCT FROM p[2])), 0)::BIGINT"},
    {"fin_resets", "(x, ts) AS coalesce(len(list_filter(list_zip((list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[2:], (list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[:-2]), lambda p: p[1] < p[2])), 0)::BIGINT"},
    {"fin_last_non_null", "(x, ts) AS (list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[-1]"},
    {"fin_first_non_null", "(x, ts) AS (list(x ORDER BY ts, x) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL))[1]"},
    {"fin_autocorr", "(x, ts, lag := 1) AS finance_autocorr_internal(x::DOUBLE, ts, lag)"},
    {"fin_crosscorr", "(x, y, ts, lag := 0) AS finance_crosscorr_internal(x::DOUBLE, y::DOUBLE, ts, lag)"},
    {"fin_hurst", "(x, ts) AS finance_hurst_internal(x::DOUBLE, ts)"},
    {"fin_half_life_mean_reversion", "(x, ts) AS finance_half_life_internal(x::DOUBLE, ts)"},
    {"fin_linear_trend", "(y, x) AS CASE WHEN bool_or(y IS NOT NULL AND x IS NOT NULL AND NOT (isfinite(y::DOUBLE) AND isfinite(x::DOUBLE))) THEN NULL ELSE struct_pack(slope := CASE WHEN regr_sxx(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) > 0 THEN regr_slope(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) END, intercept := CASE WHEN regr_sxx(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) > 0 THEN regr_intercept(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) END, r2 := CASE WHEN regr_sxx(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) > 0 THEN regr_r2(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) END, stderr := CASE WHEN regr_sxx(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) > 0 AND regr_count(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) > 2 THEN sqrt(greatest(0.0, regr_syy(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) - regr_sxy(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) * regr_sxy(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) / regr_sxx(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE))) / (regr_count(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE)) - 2) / regr_sxx(y::DOUBLE, x::DOUBLE) FILTER (WHERE isfinite(y::DOUBLE) AND isfinite(x::DOUBLE))) END) END"},
    {"fin_adf", "(x, ts, max_lag := 1, regression := 'c') AS finance_adf_internal(x::DOUBLE, ts, max_lag, regression)"},
    {"fin_ljung_box", "(x, ts, lags := 10) AS finance_ljung_box_internal(x::DOUBLE, ts, lags)"},
