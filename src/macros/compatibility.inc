    {"fin_relative_date_add", "(date_rule, strict := false) AS coalesce(try_cast(left(date_rule, len(date_rule) - 1) AS DOUBLE) * CASE lower(right(date_rule, 1)) WHEN 'd' THEN 1.0 WHEN 'b' THEN 1.0 WHEN 'w' THEN 7.0 WHEN 'm' THEN 30.0 WHEN 'f' THEN 30.0 WHEN 'y' THEN 365.0 ELSE NULL END, 0.0)"},
    {"fin_to_zulu_string", "(ts) AS strftime(ts, '%Y-%m-%dT%H:%M:%S') || 'Z'"},
    {"fin_time_difference_as_string", "(seconds, resolution := 'Second') AS CASE WHEN abs(seconds) >= 31536000 THEN floor(abs(seconds) / 31536000)::BIGINT::VARCHAR || CASE WHEN floor(abs(seconds) / 31536000) = 1 THEN ' Year' ELSE ' Years' END WHEN abs(seconds) >= 604800 THEN floor(abs(seconds) / 604800)::BIGINT::VARCHAR || CASE WHEN floor(abs(seconds) / 604800) = 1 THEN ' Week' ELSE ' Weeks' END WHEN abs(seconds) >= 86400 THEN floor(abs(seconds) / 86400)::BIGINT::VARCHAR || CASE WHEN floor(abs(seconds) / 86400) = 1 THEN ' Day' ELSE ' Days' END WHEN abs(seconds) >= 3600 THEN floor(abs(seconds) / 3600)::BIGINT::VARCHAR || CASE WHEN floor(abs(seconds) / 3600) = 1 THEN ' Hour' ELSE ' Hours' END WHEN abs(seconds) >= 60 THEN floor(abs(seconds) / 60)::BIGINT::VARCHAR || CASE WHEN floor(abs(seconds) / 60) = 1 THEN ' Minute' ELSE ' Minutes' END ELSE floor(abs(seconds))::BIGINT::VARCHAR || CASE WHEN floor(abs(seconds)) = 1 THEN ' Second' ELSE ' Seconds' END END"},
