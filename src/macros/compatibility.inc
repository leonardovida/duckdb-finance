    {"fin_filter_", "(x, op, value) AS CASE WHEN lower(op) IN ('=', '==', 'eq') AND x = value THEN x WHEN lower(op) IN ('!=', '<>', 'ne') AND x != value THEN x WHEN lower(op) IN ('>', 'gt') AND x > value THEN x WHEN lower(op) IN ('>=', 'ge') AND x >= value THEN x WHEN lower(op) IN ('<', 'lt') AND x < value THEN x WHEN lower(op) IN ('<=', 'le') AND x <= value THEN x ELSE NULL END"},
