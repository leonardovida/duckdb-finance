    {"finance_log1p_internal", "(x) AS CASE WHEN x IS NULL THEN NULL WHEN abs(x::DOUBLE) > 0.5 THEN ln(1 + x::DOUBLE) WHEN 1 + x::DOUBLE = 1 THEN x::DOUBLE ELSE ln(1 + x::DOUBLE) * x::DOUBLE / ((1 + x::DOUBLE) - 1) END"},
    {"finance_expm1_internal", "(x) AS CASE WHEN x IS NULL THEN NULL WHEN abs(x::DOUBLE) > 0.5 THEN exp(x::DOUBLE) - 1 WHEN exp(x::DOUBLE) = 1 THEN x::DOUBLE ELSE (exp(x::DOUBLE) - 1) * x::DOUBLE / ln(exp(x::DOUBLE)) END"},
    {"finance_periodic_rate_internal", "(rate, annualization) AS CASE WHEN rate IS NULL THEN NULL WHEN rate = 0 THEN 0.0::DOUBLE WHEN NOT isfinite(rate::DOUBLE) OR rate <= -1 THEN NULL ELSE finance_expm1_internal(finance_log1p_internal(rate::DOUBLE) / annualization::DOUBLE) END"},
    {"fin_simple_return", "(price, prev_price) AS CASE WHEN price IS NULL OR prev_price IS NULL OR prev_price = 0 THEN NULL ELSE price::DOUBLE / prev_price::DOUBLE - 1 END"},
    {"fin_log_return", "(price, prev_price) AS CASE WHEN price IS NULL OR prev_price IS NULL OR price <= 0 OR prev_price <= 0 THEN NULL ELSE ln(price::DOUBLE / prev_price::DOUBLE) END"},
    {"fin_return", "(price, prev_price, method := 'simple') AS CASE fin_parse_return_method(method) WHEN 'log' THEN fin_log_return(price, prev_price) WHEN 'simple' THEN fin_simple_return(price, prev_price) ELSE error('fin_return: unknown method ''' || coalesce(method::VARCHAR, 'NULL') || '''; supported methods are ''simple'' and ''log''') END"},
    {"fin_gross_return", "(r) AS CASE WHEN r IS NULL THEN NULL ELSE 1 + r::DOUBLE END"},
    {"fin_to_log_return", "(r) AS CASE WHEN r IS NULL OR NOT isfinite(r::DOUBLE) OR r <= -1 THEN NULL ELSE finance_log1p_internal(r::DOUBLE) END"},
    {"fin_from_log_return", "(lr) AS CASE WHEN lr IS NULL OR NOT isfinite(lr::DOUBLE) THEN NULL ELSE finance_expm1_internal(lr::DOUBLE) END"},
    {"fin_price_from_return", "(prev_price, r, method := 'simple') AS CASE fin_parse_return_method(method) WHEN 'log' THEN prev_price::DOUBLE * exp(r::DOUBLE) WHEN 'simple' THEN prev_price::DOUBLE * (1 + r::DOUBLE) ELSE error('fin_price_from_return: unknown method ''' || coalesce(method::VARCHAR, 'NULL') || '''; supported methods are ''simple'' and ''log''') END"},
    {"fin_excess_return", "(r, rf, annualization := 252, rf_convention := 'annual') AS CASE lower(rf_convention) WHEN 'periodic' THEN r::DOUBLE - rf::DOUBLE WHEN 'annual' THEN r::DOUBLE - finance_periodic_rate_internal(rf, annualization) ELSE error('fin_excess_return: unknown rf_convention ''' || coalesce(rf_convention::VARCHAR, 'NULL') || '''; supported conventions are ''annual'' and ''periodic''') END"},

    {"fin_kahan_sum", "(x) AS CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE fsum(x::DOUBLE) END"},
    {"fin_stable_mean", "(x) AS CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE fsum(x::DOUBLE) / count(x) END"},
    {"fin_stable_var", "(x, ddof := 1) AS CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE CASE WHEN isfinite(ddof::DOUBLE) AND ddof >= 0 AND count(x) > ddof THEN var_pop(x::DOUBLE) * (count(x)::DOUBLE / (count(x) - ddof)) ELSE NULL END END"},
    {"fin_stable_stddev", "(x, ddof := 1) AS sqrt(fin_stable_var(x, ddof))"},
    {"fin_stable_cov", "(y, x) AS CASE WHEN bool_or(NOT isfinite(y::DOUBLE)) OR bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE covar_samp(y::DOUBLE, x::DOUBLE) END"},
    {"fin_stable_corr", "(y, x) AS CASE WHEN bool_or(NOT isfinite(y::DOUBLE)) OR bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE corr(y::DOUBLE, x::DOUBLE) END"},
    {"fin_weighted_mean", "(x, w) AS finance_weighted_mean_internal(x::DOUBLE, w::DOUBLE, 0.0)"},
    {"fin_weighted_var", "(x, w, ddof := 0) AS finance_weighted_var_internal(x::DOUBLE, w::DOUBLE, ddof::DOUBLE)"},
    {"fin_weighted_stddev", "(x, w, ddof := 0) AS sqrt(fin_weighted_var(x, w, ddof))"},
    {"fin_mad", "(x) AS CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE mad(x::DOUBLE) END"},
    {"fin_zscore_last", "(x, ts) AS CASE WHEN bool_or(NOT isfinite(x::DOUBLE)) THEN NULL ELSE (arg_max(x::DOUBLE, struct_pack(ts := ts, x := x::DOUBLE)) FILTER (WHERE x IS NOT NULL AND ts IS NOT NULL) - avg(x::DOUBLE)) / nullif(stddev_samp(x::DOUBLE), 0) END"},

    {"fin_cum_return", "(r, method := 'simple') AS fin_total_return(r, method)"},
    {"fin_cagr", "(r, annualization := 252) AS CASE WHEN count(r) = 0 OR bool_or(NOT isfinite(r::DOUBLE) OR r < -1) THEN NULL WHEN bool_or(r = -1) THEN -1.0::DOUBLE ELSE finance_expm1_internal(fsum(finance_log1p_internal(CASE WHEN isfinite(r::DOUBLE) AND r > -1 THEN r::DOUBLE END)) * annualization::DOUBLE / count(r)) END"},
    {"fin_annual_return", "(r, annualization := 252) AS fin_cagr(r, annualization)"},
    {"fin_arithmetic_return", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE) END"},
    {"fin_geometric_return", "(r) AS fin_cagr(r, 1)"},
    {"fin_nav", "(r, initial_nav := 1.0) AS CASE WHEN count(r) = 0 OR bool_or(NOT isfinite(r::DOUBLE) OR r < -1) THEN NULL WHEN bool_or(r = -1) THEN 0.0::DOUBLE ELSE initial_nav::DOUBLE * exp(fsum(finance_log1p_internal(CASE WHEN isfinite(r::DOUBLE) AND r > -1 THEN r::DOUBLE END))) END"},
    {"fin_log_nav", "(r, initial_nav := 1.0) AS CASE WHEN count(r) = 0 OR bool_or(NOT isfinite(r::DOUBLE) OR r < -1) OR bool_or(r = -1) OR NOT (initial_nav > 0) THEN NULL ELSE ln(initial_nav::DOUBLE) + fsum(finance_log1p_internal(CASE WHEN isfinite(r::DOUBLE) AND r > -1 THEN r::DOUBLE END)) END"},
    {"fin_recovery_factor", "(r, ts) AS fin_total_return(r) / nullif(abs(fin_max_drawdown(r ORDER BY ts)), 0)"},
    {"fin_gain_to_pain", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE fsum(r::DOUBLE) / nullif(abs(fsum(r::DOUBLE) FILTER (WHERE r < 0)), 0) END"},
    {"fin_aggregate_return", "(r, method := 'simple') AS fin_total_return(r, method)"},

    {"fin_upside_deviation", "(r, threshold := 0.0, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE sqrt(avg(CASE WHEN r IS NOT NULL THEN pow(greatest(r::DOUBLE - finance_periodic_rate_internal(threshold, annualization), 0), 2) END)) * sqrt(annualization::DOUBLE) END"},
    {"fin_semivariance", "(r, threshold := 0.0, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(CASE WHEN r IS NOT NULL THEN pow(least(r::DOUBLE - finance_periodic_rate_internal(threshold, annualization), 0), 2) END) END"},
    {"fin_calmar", "(r, ts, annualization := 252) AS fin_cagr(r, annualization) / nullif(abs(fin_max_drawdown(r ORDER BY ts)), 0)"},
    {"fin_omega_ratio", "(r, required_return := 0.0, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE fsum(greatest(r::DOUBLE - finance_periodic_rate_internal(required_return, annualization), 0)) / nullif(abs(fsum(least(r::DOUBLE - finance_periodic_rate_internal(required_return, annualization), 0))), 0) END"},
    {"fin_tail_ratio", "(r, upper_q := 0.95, lower_q := 0.05) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE quantile_cont(r::DOUBLE, [lower_q, upper_q])[2] / nullif(abs(quantile_cont(r::DOUBLE, [lower_q, upper_q])[1]), 0) END"},
    {"fin_tracking_error", "(r, benchmark_r, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE stddev_samp(r::DOUBLE - benchmark_r::DOUBLE) * sqrt(annualization::DOUBLE) END"},
    {"fin_information_ratio", "(r, benchmark_r, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE - benchmark_r::DOUBLE) / nullif(stddev_samp(r::DOUBLE - benchmark_r::DOUBLE), 0) * sqrt(annualization::DOUBLE) END"},
    {"fin_active_return", "(r, benchmark_r, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE - benchmark_r::DOUBLE) * annualization::DOUBLE END"},
    {"fin_alpha", "(r, benchmark_r, risk_free := 0.0, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE (avg(r::DOUBLE - finance_periodic_rate_internal(risk_free, annualization)) FILTER (WHERE benchmark_r IS NOT NULL) - fin_beta(r, benchmark_r) * avg(benchmark_r::DOUBLE - finance_periodic_rate_internal(risk_free, annualization)) FILTER (WHERE r IS NOT NULL)) * annualization::DOUBLE END"},
    {"fin_alpha_beta", "(r, benchmark_r, risk_free := 0.0, annualization := 252) AS struct_pack(alpha := fin_alpha(r, benchmark_r, risk_free, annualization), beta := fin_beta(r, benchmark_r))"},
    {"fin_treynor_ratio", "(r, benchmark_r, risk_free := 0.0, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE - finance_periodic_rate_internal(risk_free, annualization)) FILTER (WHERE benchmark_r IS NOT NULL) * annualization::DOUBLE / nullif(fin_beta(r, benchmark_r), 0) END"},
    {"fin_jensen_alpha", "(r, benchmark_r, risk_free := 0.0, annualization := 252) AS fin_alpha(r, benchmark_r, risk_free, annualization)"},
    {"fin_up_capture", "(r, benchmark_r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE) FILTER (WHERE benchmark_r > 0) / nullif(avg(benchmark_r::DOUBLE) FILTER (WHERE benchmark_r > 0 AND r IS NOT NULL), 0) END"},
    {"fin_down_capture", "(r, benchmark_r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) OR bool_or(NOT isfinite(benchmark_r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE) FILTER (WHERE benchmark_r < 0) / nullif(avg(benchmark_r::DOUBLE) FILTER (WHERE benchmark_r < 0 AND r IS NOT NULL), 0) END"},
    {"fin_hit_ratio", "(r, threshold := 0.0, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(CASE WHEN r IS NULL THEN NULL WHEN r::DOUBLE > finance_periodic_rate_internal(threshold, annualization) THEN 1.0 ELSE 0.0 END) END"},
    {"fin_win_rate", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(CASE WHEN r IS NULL THEN NULL WHEN r > 0 THEN 1.0 ELSE 0.0 END) END"},
    {"fin_loss_rate", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(CASE WHEN r IS NULL THEN NULL WHEN r < 0 THEN 1.0 ELSE 0.0 END) END"},
    {"fin_payoff_ratio", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE) FILTER (WHERE r > 0) / nullif(abs(avg(r::DOUBLE) FILTER (WHERE r < 0)), 0) END"},
    {"fin_profit_factor", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE fsum(r::DOUBLE) FILTER (WHERE r > 0) / nullif(abs(fsum(r::DOUBLE) FILTER (WHERE r < 0)), 0) END"},
    {"fin_expectancy", "(r) AS CASE WHEN bool_or(NOT isfinite(r::DOUBLE)) THEN NULL ELSE avg(r::DOUBLE) END"},
    {"fin_expected_shortfall", "(r, confidence := 0.95, method := 'historical') AS fin_cvar(r, confidence, method, true)"},
    {"fin_parametric_var", "(mean, vol, confidence := 0.95, horizon := 1.0, distribution := 'normal', df := NULL) AS CASE WHEN confidence IS NULL OR NOT (confidence > 0 AND confidence < 1) THEN error('fin_parametric_var: confidence must be finite and in (0, 1)') WHEN lower(distribution) = 'normal' THEN -(mean::DOUBLE * horizon::DOUBLE + vol::DOUBLE * sqrt(horizon::DOUBLE) * fin_norm_inv(1 - confidence::DOUBLE)) WHEN lower(distribution) IN ('t', 'student_t') THEN CASE WHEN df IS NULL OR NOT (df > 2) OR NOT isfinite(df::DOUBLE) THEN error('fin_parametric_var: df must be finite and greater than 2 for the t distribution') ELSE -(mean::DOUBLE * horizon::DOUBLE + vol::DOUBLE * sqrt(horizon::DOUBLE) * sqrt((df::DOUBLE - 2) / df::DOUBLE) * fin_student_t_inv(1 - confidence::DOUBLE, df::DOUBLE)) END ELSE error('fin_parametric_var: unknown distribution ''' || coalesce(distribution::VARCHAR, 'NULL') || '''; supported distributions are ''normal'' and ''t''') END"},
    {"fin_parametric_cvar", "(mean, vol, confidence := 0.95, horizon := 1.0, distribution := 'normal', df := NULL) AS CASE WHEN confidence IS NULL OR NOT (confidence > 0 AND confidence < 1) THEN error('fin_parametric_cvar: confidence must be finite and in (0, 1)') WHEN lower(distribution) = 'normal' THEN -(mean::DOUBLE * horizon::DOUBLE - vol::DOUBLE * sqrt(horizon::DOUBLE) * fin_norm_pdf(fin_norm_inv(1 - confidence::DOUBLE)) / (1 - confidence::DOUBLE)) WHEN lower(distribution) IN ('t', 'student_t') THEN CASE WHEN df IS NULL OR NOT (df > 2) OR NOT isfinite(df::DOUBLE) THEN error('fin_parametric_cvar: df must be finite and greater than 2 for the t distribution') ELSE -(mean::DOUBLE * horizon::DOUBLE - vol::DOUBLE * sqrt(horizon::DOUBLE) * sqrt((df::DOUBLE - 2) / df::DOUBLE) * exp(lgamma((df::DOUBLE + 1) / 2) - lgamma(df::DOUBLE / 2)) / sqrt(df::DOUBLE * pi()) * pow(1 + fin_student_t_inv(1 - confidence::DOUBLE, df::DOUBLE) * fin_student_t_inv(1 - confidence::DOUBLE, df::DOUBLE) / df::DOUBLE, -(df::DOUBLE + 1) / 2) / (1 - confidence::DOUBLE) * (df::DOUBLE + fin_student_t_inv(1 - confidence::DOUBLE, df::DOUBLE) * fin_student_t_inv(1 - confidence::DOUBLE, df::DOUBLE)) / (df::DOUBLE - 1)) END ELSE error('fin_parametric_cvar: unknown distribution ''' || coalesce(distribution::VARCHAR, 'NULL') || '''; supported distributions are ''normal'' and ''t''') END"},

    {"fin_realized_variance", "(log_r, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(log_r::DOUBLE)) THEN NULL ELSE fsum(log_r::DOUBLE * log_r::DOUBLE) * annualization::DOUBLE / count(log_r) END"},
    {"fin_realized_vol", "(log_r, annualization := 252) AS sqrt(fin_realized_variance(log_r, annualization))"},
    {"fin_realized_quarticity", "(log_r, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(log_r::DOUBLE)) THEN NULL ELSE count(log_r) * fsum(pow(log_r::DOUBLE, 4)) * annualization::DOUBLE / 3.0 END"},
    {"fin_parkinson_vol", "(high, low, annualization := 252) AS CASE WHEN bool_or(NOT (isfinite(high::DOUBLE) AND isfinite(low::DOUBLE) AND low > 0 AND high >= low)) THEN NULL ELSE sqrt(annualization::DOUBLE * avg(pow(ln(high::DOUBLE / low::DOUBLE), 2)) / (4 * ln(2))) END"},
    {"fin_garman_klass_vol", "(open, high, low, close, annualization := 252) AS CASE WHEN bool_or(NOT (isfinite(open::DOUBLE) AND isfinite(high::DOUBLE) AND isfinite(low::DOUBLE) AND isfinite(close::DOUBLE) AND low > 0 AND high >= low AND open BETWEEN low AND high AND close BETWEEN low AND high)) OR avg(CASE WHEN high > 0 AND low > 0 AND open > 0 AND close > 0 THEN 0.5 * pow(ln(high::DOUBLE / low::DOUBLE), 2) - (2 * ln(2) - 1) * pow(ln(close::DOUBLE / open::DOUBLE), 2) END) < 0 THEN NULL ELSE sqrt(annualization::DOUBLE * avg(CASE WHEN high > 0 AND low > 0 AND open > 0 AND close > 0 THEN 0.5 * pow(ln(high::DOUBLE / low::DOUBLE), 2) - (2 * ln(2) - 1) * pow(ln(close::DOUBLE / open::DOUBLE), 2) END)) END"},
    {"fin_rogers_satchell_vol", "(open, high, low, close, annualization := 252) AS CASE WHEN bool_or(NOT (isfinite(open::DOUBLE) AND isfinite(high::DOUBLE) AND isfinite(low::DOUBLE) AND isfinite(close::DOUBLE) AND low > 0 AND high >= low AND open BETWEEN low AND high AND close BETWEEN low AND high)) OR avg(CASE WHEN high > 0 AND low > 0 AND open > 0 AND close > 0 THEN ln(high::DOUBLE / close::DOUBLE) * ln(high::DOUBLE / open::DOUBLE) + ln(low::DOUBLE / close::DOUBLE) * ln(low::DOUBLE / open::DOUBLE) END) < 0 THEN NULL ELSE sqrt(annualization::DOUBLE * avg(CASE WHEN high > 0 AND low > 0 AND open > 0 AND close > 0 THEN ln(high::DOUBLE / close::DOUBLE) * ln(high::DOUBLE / open::DOUBLE) + ln(low::DOUBLE / close::DOUBLE) * ln(low::DOUBLE / open::DOUBLE) END)) END"},
    {"fin_vol_of_vol", "(vol, annualization := 252) AS CASE WHEN bool_or(NOT isfinite(vol::DOUBLE)) THEN NULL ELSE stddev_samp(vol::DOUBLE) * sqrt(annualization::DOUBLE) END"},
    {"fin_realized_beta", "(r, benchmark_r) AS fin_beta(r, benchmark_r)"},
    {"fin_realized_corr", "(r1, r2) AS CASE WHEN bool_or(NOT isfinite(r1::DOUBLE)) OR bool_or(NOT isfinite(r2::DOUBLE)) THEN NULL ELSE corr(r1::DOUBLE, r2::DOUBLE) END"},
    {"fin_realized_cov", "(r1, r2) AS CASE WHEN bool_or(NOT isfinite(r1::DOUBLE)) OR bool_or(NOT isfinite(r2::DOUBLE)) THEN NULL ELSE covar_samp(r1::DOUBLE, r2::DOUBLE) END"},
