    // Bar builders. Every column uses the same rows (all arguments non-NULL), and
    // open/close come from the first/last ts; ts ties pick the smaller open and
    // the larger close, so results do not depend on row order or thread count.
    {"fin_ohlc", "(price, ts) AS struct_pack(open := finance_first_by_internal(price::DOUBLE, ts), high := max(price::DOUBLE) FILTER (WHERE ts IS NOT NULL), low := min(price::DOUBLE) FILTER (WHERE ts IS NOT NULL), close := finance_last_by_internal(price::DOUBLE, ts))"},
    {"fin_ohlcv", "(price, volume, ts) AS struct_pack(open := finance_first_by_internal(price::DOUBLE, ts) FILTER (WHERE volume IS NOT NULL), high := max(price::DOUBLE) FILTER (WHERE ts IS NOT NULL AND volume IS NOT NULL), low := min(price::DOUBLE) FILTER (WHERE ts IS NOT NULL AND volume IS NOT NULL), close := finance_last_by_internal(price::DOUBLE, ts) FILTER (WHERE volume IS NOT NULL), volume := sum(volume::DOUBLE) FILTER (WHERE price IS NOT NULL AND ts IS NOT NULL), vwap := fin_vwap(price, volume) FILTER (WHERE ts IS NOT NULL))"},
